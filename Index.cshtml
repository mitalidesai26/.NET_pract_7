@model IEnumerable<FeedbackManagementMVC.Models.Feedback>

@{
    ViewData["Title"] = "Feedback Management";
}

<div class="container mt-4">
    <h2>Feedback Management System</h2>
    <p>Submit your feedback below.</p>
    <hr />

    <h4>Feedback Form</h4>
    @await Html.PartialAsync("_FeedbackForm", new FeedbackManagementMVC.Models.Feedback())

    <hr />
    <h4>Submitted Feedback</h4>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Comments</th>
                        <th>Rating</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Email</td>
                        <td>@item.Comments</td>
                        <td>@item.Rating / 5</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p>No feedback submitted yet.</p>
    }
</div>
